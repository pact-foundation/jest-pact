{
  "name": "jest-pact",
  "version": "0.14.0",
  "description": "a pact adaptor for jest",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./v3": {
      "types": "./dist/v3/index.d.ts",
      "default": "./dist/v3/index.js"
    },
    "./dist/v3": {
      "types": "./dist/v3/index.d.ts",
      "default": "./dist/v3/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "CHANGELOG.md"
  ],
  "typesVersions": {
    "*": {
      "v3": [
        "dist/v3/index.d.ts"
      ]
    }
  },
  "scripts": {
    "lint:biome": "biome lint",
    "lint:tsc": "tsc --noEmit && tsc -p tsconfig.scripts.json",
    "lint": "npm run lint:biome && npm run lint:tsc",
    "lint:fix": "biome lint --write",
    "format": "biome format",
    "format:fix": "biome format --write",
    "check": "biome check && npm run lint:tsc",
    "check:fix": "biome check --write",
    "build": "rimraf dist && tsc --project tsconfig.dist.json",
    "check:package": "attw --pack .",
    "test": "jest --coverage --runInBand --verbose --coverageReporters=lcov",
    "dist": "npm run check && npm run test && npm run build && npm run check:package"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pact-foundation/jest-pact.git"
  },
  "engines": {
    "node": ">=22"
  },
  "author": "YOU54F",
  "contributors": [
    {
      "name": "Yousaf Nabi",
      "url": "https://github.com/YOU54F"
    },
    {
      "name": "Timothy Jones",
      "url": "https://github.com/TimothyJones"
    }
  ],
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/pact-foundation/jest-pact/issues"
  },
  "homepage": "https://github.com/pact-foundation/jest-pact/#readme",
  "devDependencies": {
    "@arethetypeswrong/cli": "0.18.5",
    "@biomejs/biome": "2.5.14",
    "@pact-foundation/pact": "17.1.4",
    "@tsconfig/node22": "22.0.6",
    "@types/jest": "30.0.0",
    "@types/supertest": "7.2.1",
    "jest": "30.5.2",
    "jest-junit": "17.0.0",
    "rimraf": "6.1.3",
    "supertest": "7.2.2",
    "ts-jest": "29.4.13",
    "typescript": "5.9.3"
  },
  "peerDependencies": {
    "@pact-foundation/pact": "^16.0.0 || ^17.0.0",
    "jest": "^24.0.0 || ^25.0.0 || ^26.0.0 || ^27.0.0 || ^28.0.0 || ^29.0.0 || ^30.0.0"
  }
}
