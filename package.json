{
  "name": "jest-pact",
  "version": "0.13.0",
  "description": "a pact adaptor for jest",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./v3": {
      "types": "./dist/v3/index.d.ts",
      "default": "./dist/v3/index.js"
    },
    "./dist/v3": {
      "types": "./dist/v3/index.d.ts",
      "default": "./dist/v3/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "CHANGELOG.md"
  ],
  "typesVersions": {
    "*": {
      "v3": [
        "dist/v3/index.d.ts"
      ]
    }
  },
  "scripts": {
    "lint:biome": "biome lint",
    "lint:tsc": "tsc --noEmit",
    "lint": "npm run lint:biome && npm run lint:tsc",
    "lint:fix": "biome lint --write",
    "format": "biome format",
    "format:fix": "biome format --write",
    "check": "biome check && npm run lint:tsc",
    "check:fix": "biome check --write",
    "build": "rimraf dist && tsc --project tsconfig.dist.json",
    "check:package": "attw --pack .",
    "test": "jest --coverage --runInBand --verbose --coverageReporters=lcov",
    "dist": "npm run check && npm run test && npm run build && npm run check:package",
    "release": "commit-and-tag-version",
    "release:dryrun": "npm run test && npm publish --dry-run",
    "release:trigger": "./scripts/trigger-release.sh"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pact-foundation/jest-pact.git"
  },
  "engines": {
    "node": ">=22"
  },
  "author": "YOU54F",
  "contributors": [
    {
      "name": "Yousaf Nabi",
      "url": "https://github.com/YOU54F"
    },
    {
      "name": "Timothy Jones",
      "url": "https://github.com/TimothyJones"
    }
  ],
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/pact-foundation/jest-pact/issues"
  },
  "homepage": "https://github.com/pact-foundation/jest-pact/#readme",
  "devDependencies": {
    "@arethetypeswrong/cli": "0.18.5",
    "@biomejs/biome": "2.5.14",
    "@pact-foundation/pact": "^16.0.0",
    "@tsconfig/node24": "24.0.0",
    "@types/jest": "^30.0.0",
    "@types/supertest": "6.0.3",
    "commit-and-tag-version": "13.2.1",
    "jest": "^30.0.0",
    "jest-junit": "16.0.0",
    "rimraf": "6.1.2",
    "supertest": "7.1.4",
    "ts-jest": "^29.0.3",
    "typescript": "5.9.3"
  },
  "peerDependencies": {
    "@pact-foundation/pact": "^16.0.0",
    "jest": "^24.0.0 || ^25.0.0 || ^26.0.0 || ^27.0.0 || ^28.0.0 || ^29.0.0 || ^30.0.0"
  },
  "commit-and-tag-version": {
    "types": [
      {
        "type": "feat",
        "section": "Features"
      },
      {
        "type": "fix",
        "section": "Bug Fixes"
      },
      {
        "type": "chore",
        "section": "Dependencies",
        "scope": "deps"
      },
      {
        "type": "style",
        "hidden": true
      },
      {
        "type": "refactor",
        "hidden": true
      },
      {
        "type": "perf",
        "hidden": true
      },
      {
        "type": "test",
        "hidden": true
      }
    ]
  }
}
