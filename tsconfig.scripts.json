{
  "extends": "@tsconfig/node22/tsconfig.json",
  "compilerOptions": {
    "erasableSyntaxOnly": true,
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "noEmit": true,
    "noImplicitReturns": true,
    "noPropertyAccessFromIndexSignature": true,
    "noUnusedLocals": true,
    "types": ["node"]
  },
  "include": ["./scripts/**/*.ts"]
}
